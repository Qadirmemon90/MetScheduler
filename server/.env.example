PORT=3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/scheduler
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
ADMIN_EMAILS=admin@metscheduler.com,admin@example.com

# Redis Cache & Distributed Rate Limiting (optional: falls back to in-memory cache if omitted)
REDIS_URL=redis://127.0.0.1:6379

# AI & Media Generation
GEMINI_API_KEY=your_gemini_api_key
LEONARDO_API_KEY=your_leonardo_api_key

# Cloudinary Storage for Media & Payment Receipts (optional: falls back to local /uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Social Publishing Gateway
ZERNIO_API_KEY=your_zernio_api_key

DEBUG_SECRET=your_debug_secret
CRON_SECRET=your_cron_secret
